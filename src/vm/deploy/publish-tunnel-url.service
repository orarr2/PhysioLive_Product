[Unit]
Description=Publish current TryCloudflare URL to the PhysioLive web app
After=cloudflared.service
Requires=cloudflared.service

[Service]
Type=oneshot
User=root
EnvironmentFile=-/etc/physiolive/tunnel-publisher.env
ExecStart=/opt/physiolive/repo/src/vm/deploy/publish-tunnel-url.sh
# Keep noise out of the journal on the common "unchanged" path.
StandardOutput=journal
StandardError=journal
