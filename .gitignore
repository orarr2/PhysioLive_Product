__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
build/
dist/

# Notebooks
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Project data (large or private). We keep the READMEs, .gitkeep
# placeholders, the seed corpus, and reference signatures in git;
# everything else stays out.
data/**
!data/
!data/**/
!data/**/.gitkeep
!data/**/README.md
!data/corpus_seed/*.json
!data/reference_signatures/**/*.json
*.mp4
*.mkv
*.mov
*.avi
*.webm

# Model weights (fetched on demand)
*.pt
*.onnx
*.keras
*.h5
*.joblib
*_openvino_model/

# Session outputs (top-level only; data/sessions/.gitkeep is tracked)
/sessions/
*.db
*.sqlite
*.sqlite3

# User config
config.local.yaml
~/.physiolive/

# OS / temp
*.log
*.tmp
tmp/

# Scratchpad from tools
scratchpad/

# Internal Hebrew planning document (kept locally, out of the public repo)
PhysioLive_Product_Spec.md
